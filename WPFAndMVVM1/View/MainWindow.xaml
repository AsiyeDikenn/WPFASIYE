<Window x:Class="WPFAndMVVM1.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:WPFAndMVVM1"
        mc:Ignorable="d"
        Title="MainWindow" Height="450" Width="800">
    <Grid x:Name="__">

        <Label Content="{Binding MyLabelText}" HorizontalAlignment="Left" Margin="127,110,0,0" VerticalAlignment="Top" Width="120"/>
        <TextBox Text="{Binding MyTextBoxText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"  HorizontalAlignment="Left" Margin="280,118,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"/>

        <TextBox x:Name="tbRight" HorizontalAlignment="Left" Margin="280,199,0,0" TextWrapping="Wrap" Text="TextBox3" VerticalAlignment="Top" Width="120"/>
        <TextBox x:Name="tbLeft" HorizontalAlignment="Left" Margin="127,199,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120" 
                 Text="{Binding ElementName=tbRight, Path=Text, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"/>
        
        <Slider x:Name="valueSlider" HorizontalAlignment="Left" Margin="127,299,0,0" VerticalAlignment="Top" Minimum="0" Maximum="100" Width="120" TickFrequency="1" IsSnapToTickEnabled="True"/>
        <TextBox HorizontalAlignment="Left" Margin="280,290,0,0" TextWrapping="Wrap" VerticalAlignment="Top" Width="120"
                 Text="{Binding ElementName=valueSlider, Path=Value, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0}}"/>
        <Button Content="Update Label" Click="Button_Click" HorizontalAlignment="Left" Margin="28,116,0,0" VerticalAlignment="Top"/>
    </Grid>
</Window>
